# GitHub personal access token (classic or fine-grained, read-only is enough).
# Without one you get 60 requests/hour; with one, 5,000.
GITHUB_TOKEN=

MONGO_URI=mongodb://localhost:27017
MONGO_DB=commit_analyzer

# Standard 5-field cron expression for the background sync job (UTC).
SYNC_CRON=0 * * * *
# Set to false to disable the in-process scheduler (e.g. if you use system cron instead).
SCHEDULER_ENABLED=true

# On a user's first sync, how far back to pull commits.
INITIAL_SYNC_DAYS=365
